# Replace with a securely generated Base64-encoded 32-byte key.
VISIONSEARCH_AES_KEY=REPLACE_WITH_BASE64_ENCODED_32_BYTE_KEY

# Configure explicit browser origins; wildcard origins are not accepted.
VISIONSEARCH_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Keep Secure=true in HTTPS deployments. Use false only for local HTTP development.
VISIONSEARCH_AUTH_COOKIE_SECURE=true
VISIONSEARCH_AUTH_SESSION_TTL_MINUTES=60
